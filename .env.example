# --- Express server ---
PORT=8080

# --- OpenClaw gateway connection ---
# Gateway on host: ws://127.0.0.1:18789. Express-in-Docker (Desktop): often ws://host.docker.internal:18789
OPENCLAW_GATEWAY_URL=ws://localhost:18789
# Must match OPENCLAW_GATEWAY_TOKEN set on the gateway side
OPENCLAW_GATEWAY_TOKEN=replace-with-the-token-from-your-gateway

# System prompt file (default: persona.txt in this folder). Missing or empty = no persona.
# PERSONA_FILE_PATH=/absolute/path/to/persona.txt

# --- Autopilot (the AI texts matches as you) ---
# Comma-separated E.164 numbers of matches the AI may text. Used by /api/autopilot/* and
# written to the gateway's WhatsApp allowlist by `npm run whatsapp:sync`.
# Add a match with `npm run match:add -- +<number>` (updates this line and the gateway).
AUTOPILOT_NUMBERS=
